# Docker ignore file - excludes unnecessary files from Docker image
# Reduces image size and build time

# Version control
.git
.gitignore
.gitattributes

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.editorconfig

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv
env/
.env

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
*.cover
.coverage.*

# Documentation
docs/
*.md
!README.md

# Development
logs/
*.log
*.pid
*.seed
*.pid.lock

# Environment
.env.local
.env.*.local

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Database
*.db
*.sqlite
*.sqlite3

